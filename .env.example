# This first pass is a non-transactional demo.
NEXT_PUBLIC_APP_MODE=demo

# Optional Apex-only connection for local read-only catalog preview.
# Vercel has these set for Preview/Development; do not commit actual values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only checkout page mode. Default OFF if unset.
# Set to 'demo' in an approved environment to show simulated checkout.
# 'live' is deliberately UNSUPPORTED and returns 404: no real payments exist.
APEX_CHECKOUT_MODE=off
