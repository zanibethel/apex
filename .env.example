# This first pass is a non-transactional demo.
NEXT_PUBLIC_APP_MODE=demo

# Optional Apex-only connection for local read-only catalog preview.
# Vercel has these set for Preview/Development; do not commit actual values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only checkout page mode. Default OFF if unset.
# Set to 'demo' in an approved environment to show simulated checkout.
# 'live' is deliberately UNSUPPORTED and returns 404: no real payments exist.
APEX_CHECKOUT_MODE=off

# Admin-only private price/stock readback from the separately reviewed SQL RPC.
# The RPC is NOT installed by this repository PR. Keep OFF until the private
# database function is approved, applied, and its RLS/permissions verified.
# Setting this to enabled does NOT authorize public prices, cart lines or sales.
APEX_PRIVATE_STOCK_READBACK=off


# PUBLIC SOLD-OUT CATALOG — DEFAULT OFF. Public gallery uses an explicit
# independently verified supplier/product release RPC, not private draft data.
# Review-only SQL is NOT deployed by this PR. Keep OFF until legal/product
# eligibility, supplier authorization, dedicated public imagery, RLS checks,
# and a separately reviewed release-gate migration are complete.
# This setting never enables checkout, stock reservation, or BTC payments.
APEX_PUBLIC_SOLD_OUT_CATALOG=off
